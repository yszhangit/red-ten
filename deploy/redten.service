[Unit]
Description=Red Ten (红十) card game server
After=network-online.target
Wants=network-online.target

[Service]
User=redten
Group=redten
WorkingDirectory=/opt/redten/app
EnvironmentFile=/etc/redten.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/redten/venv/bin/python src/web_server.py
Restart=on-failure
RestartSec=3

# Port 80 without running as root, and little else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
