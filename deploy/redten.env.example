# Settings for the hosted game server. install.sh writes this to /etc/redten.env
# (readable by root only). After editing: sudo systemctl restart redten
#
# The passcode everyone types once to get in. Letters, digits, and - _ . only,
# at least 6 characters. Changing it logs everybody out.
REDTEN_PASSCODE=change-me-please

REDTEN_HOSTED=1
REDTEN_HOST=0.0.0.0
REDTEN_PORT=80
# Tables that may be open at once, and minutes before a table nobody is
# connected to is closed.
REDTEN_MAX_ROOMS=3
REDTEN_IDLE_MINUTES=10
